# QYBERNEX Environment Configuration Example
# Copy this file to .env and configure values for local or deployment environment.

# Application General Settings
PROJECT_NAME="QYBERNEX"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Configuration (Comma-separated origins allowed to access backend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="qybernex"
POSTGRES_PASSWORD="qybernex_dev_password_change_in_prod"
POSTGRES_DB="qybernex_db"

# Redis Configuration (Optional for background tasks/caching)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security & Secrets (Must be changed in production)
SECRET_KEY="qybernex_super_secret_jwt_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
